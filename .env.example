# ==============================================================================
# Optional AI API Providers (Server-Side Only via Settings > Secrets or .env)
# All keys below are COMPLETELY OPTIONAL. Without any key, the platform runs
# using its built-in Advanced Local Academic Editing Engine.
# ==============================================================================

# 1) Google Gemini (AI Studio)
GEMINI_API_KEY=""
# Optional Gemini model override (defaults to gemini-2.5-flash)
# GEMINI_MODEL="gemini-2.5-flash"

# 2) Universal OpenAI-Compatible API (works with ANY platform: OpenRouter,
#    OpenAI, Groq, DeepSeek, Together, Mistral, xAI Grok, Cerebras,
#    Fireworks, Perplexity, HuggingFace, Ollama, vLLM, etc.)
# LLM_API_KEY=""
# LLM_BASE_URL="https://openrouter.ai/api/v1"
# LLM_MODEL="google/gemini-2.5-flash"
# LLM_PROVIDER_NAME="مزود مخصص"

# 3) Zero-config Named Platform Keys (auto-configured endpoints on the server)
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="openai/gpt-4o-mini"
# GROQ_API_KEY=""
# GROQ_MODEL="llama-3.3-70b-versatile"
# DEEPSEEK_API_KEY=""
# DEEPSEEK_MODEL="deepseek-chat"
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-3-5-sonnet-latest"
# TOGETHER_API_KEY=""
# TOGETHER_MODEL="meta-llama/Llama-3.3-70B-Instruct-Turbo"
# MISTRAL_API_KEY=""
# MISTRAL_MODEL="mistral-large-latest"
# XAI_API_KEY=""
# XAI_MODEL="grok-3-mini"
# CEREBRAS_API_KEY=""
# CEREBRAS_MODEL="llama-3.3-70b"
# OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
# OLLAMA_MODEL="qwen2.5:14b"

# ==============================================================================
# Application Runtime & Deployment Settings
# ==============================================================================
NODE_ENV="production"
PORT="3000"
APP_URL="MY_APP_URL"
# REQUIRED in production (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
# REQUIRED: the only email that becomes admin. Register with it IMMEDIATELY after first deploy.
ADMIN_EMAIL=""
# Demo only (insecure browser-side accounts). Leave unset in production.
# VITE_ALLOW_LOCAL_MODE="true"
# Optional persistent storage path (recommended when mounting a disk on Render/Railway/Cloud Run)
# DATA_DIR="/app/data"

# Free persistent storage (Upstash Redis REST) - recommended on free hosts
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
